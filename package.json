{
  "name": "victoria-bot-vip",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de vendas de assinatura para grupo VIP privado no Telegram (Telegram Stars)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/scripts/seed.js && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/scripts/seed.ts",
    "postinstall": "prisma generate",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pino": "10.4.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "telegraf": "4.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "^13.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
