# Copie para .env (local) ou configure no painel da hospedagem (Railway/Render).
# NUNCA faça commit dos valores reais.

NODE_ENV=production
LOG_LEVEL=info

# Token do @BotFather
BOT_TOKEN=

# PostgreSQL (ex.: Neon). Use sslmode=require.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ID do grupo VIP privado (número negativo, começa com -100)
GROUP_CHAT_ID=-1001234567890

# IDs do Telegram dos administradores, separados por vírgula
ADMIN_IDS=123456789

# Webhook (opcional). Se vazio, o bot usa long polling.
# Domínio público SEM https:// (ex.: victoria-bot.up.railway.app)
WEBHOOK_DOMAIN=
# Segredo aleatório (mín. 32 chars, só letras/números/_/-). Gere com: openssl rand -hex 32
WEBHOOK_SECRET=
PORT=3000

# PIX com aprovação manual (opcional). Deixe PIX_KEY vazio para desativar.
# A chave deve estar no nome/CPF/CNPJ da cliente. Telefone no formato +5511999999999.
PIX_KEY=
# Nome do recebedor (até 25 letras, sem acento é o ideal) e cidade (até 15)
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Usuário de suporte exibido no /paysupport (sem @)
SUPPORT_USERNAME=
